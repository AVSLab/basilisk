include_guard(GLOBAL)

function(bsk_check_python_version PYPROJECT_PATH)
  set(VERSION_CHECK_SCRIPT
      "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../buildSupport/checkPythonVersion.py")
  execute_process(
    COMMAND "${Python3_EXECUTABLE}" "${VERSION_CHECK_SCRIPT}" "${PYPROJECT_PATH}"
    RESULT_VARIABLE VERSION_CHECK_RESULT
    OUTPUT_VARIABLE VERSION_CHECK_OUTPUT
    ERROR_VARIABLE VERSION_CHECK_ERROR
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_STRIP_TRAILING_WHITESPACE)
  if(NOT "${VERSION_CHECK_RESULT}" STREQUAL "0")
    message(FATAL_ERROR
      "Python version validation failed (${VERSION_CHECK_RESULT}).\n"
      "${VERSION_CHECK_OUTPUT}${VERSION_CHECK_ERROR}")
  endif()
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
               "${PYPROJECT_PATH}" "${VERSION_CHECK_SCRIPT}")
endfunction()
