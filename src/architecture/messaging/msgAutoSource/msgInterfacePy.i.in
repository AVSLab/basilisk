%module(threads="1") {type}Payload
%{{
    #include "{baseDir}/{type}Payload.h"
    #include "architecture/messaging/messaging.h"
    // Per-payload PayloadEqualityTraits<{type}Payload> specialization (auto-generated).
    #include "{type}Payload_equality.h"
    #include <stdint.h>
    #include <vector>
    #include <deque>
    #include <string>
%}}
%include "messaging/newMessaging.ih"
%import "architecture/messaging/messagingBase.i"

// These generic interfaces provide code-generation fragments used by each
// payload's own message/reader/recorder vector wrappers.  Their shared concrete
// helper types are instantiated only by messagingSupport below.
%include "std_vector.i"
%include "std_string.i"
%include "_GeneralModuleFiles/swig_eigen.i"
%include "_GeneralModuleFiles/swig_conly_data.i"
%include "stdint.i"

#define BSK_MESSAGING_SUPPORT_IMPORT
%import "architecture/messaging/messagingSupport.i"
#undef BSK_MESSAGING_SUPPORT_IMPORT
%include "architecture/messaging/messagingSupportTypemaps.swg"

%pythoncode %{{
from Basilisk.architecture.messaging.messagingSupport import *
%}};

%ignore SysModel::SysModel(const SysModel &);
%ignore SysModel::operator=(const SysModel &);
// Keep C++-only ownership operations out of the public Python API.
%ignore ReadFunctor::ReadFunctor(ReadFunctor &&);
%ignore ReadFunctor::operator=(const ReadFunctor &);
%ignore ReadFunctor::operator=(ReadFunctor &&);
%ignore ReadFunctor::setSource;
%ignore Message::Message(const Message &);
%ignore Message::Message(Message &&);
%ignore Message::operator=(const Message &);
%ignore Message::operator=(Message &&);

%pythonappend Recorder::Recorder %{{
    from Basilisk.architecture.messaging import _msgKeepAlive
    if args:
        _msgKeepAlive.retainRecorderConstructorSource(self, args[0], {type})
%}}

%include "messaging/messaging.h"
%include "_GeneralModuleFiles/sys_model.h"

%rename(__subscribe_to) subscribeTo;  // we want the users to have a unified "subscribeTo" interface
%rename(__subscribe_to_C) subscribeToC;  // we want the users to have a unified "subscribeTo" interface
%rename(__is_subscribed_to) isSubscribedTo;  // we want the users to have a unified "isSubscribedTo" interface
%rename(__is_subscribed_to_C) isSubscribedToC;  // we want the users to have a unified "isSubscribedTo" interface
%rename(__time_vector) times;  // It's not really useful to give the user back a time vector
%rename(__timeWritten_vector) timesWritten;
// record() returns the internal std::deque by reference for the C++ recorder typemaps; it is not
// wrapped for Python. Python instead uses recordList(), which returns a randomly-indexable std::vector
// copy (see issue #788). std::deque is intentionally not exposed to Python: SWIG's std_deque.i does not
// provide integer __getitem__ for value-type elements, which would break recorder[i] indexing.
%ignore Recorder::record;
// Internal callback bridge used by Message.recorder(); not part of the Python API.
%ignore Recorder::setSource;
%rename(__record_vector) recordList;

%pythoncode %{{
import numpy as np
%}};
{extraShadowFeature}
%include "{baseDir}/{type}Payload.h"
{extraContent}
INSTANTIATE_TEMPLATES({type}, {type}Payload, {baseDir})
%template({type}OutMsgsVector) std::vector<Message<{type}Payload>, std::allocator<Message<{type}Payload>> >;
%template({type}OutMsgsPtrVector) std::vector<Message<{type}Payload>*, std::allocator<Message<{type}Payload>*> >;
%template({type}InMsgsVector) std::vector<ReadFunctor<{type}Payload>, std::allocator<ReadFunctor<{type}Payload>> >;
{extraPythonContent}
%pythoncode %{{
if "{type}" == "EclipseMsg":
    from . import _{type}Payload as _m
    from Basilisk.utilities import deprecated

    # ----- __init__ alias: accept illuminationFactor as synonym for shadowFactor -----
    _orig_init = {type}Payload.__init__

    def _init_with_alias(self, *, illuminationFactor=..., shadowFactor=..., **kwargs):
        if shadowFactor is not ...:
            deprecated.deprecationWarn(
                "EclipseMsgPayload(shadowFactor=...)",
                "2026/12/31",
                "Use EclipseMsgPayload(illuminationFactor=...) instead.",
            )
            illuminationFactor = shadowFactor
        _orig_init(self, **kwargs)
        if illuminationFactor is not ...:
            _m.{type}Payload_shadowFactor_set(self, illuminationFactor)

    {type}Payload.__init__ = _init_with_alias

    # ----- Payload aliasing -----
    def _get_illum(self):
        return _m.{type}Payload_shadowFactor_get(self)

    def _set_illum(self, v):
        _m.{type}Payload_shadowFactor_set(self, v)

    {type}Payload.illuminationFactor = property(_get_illum, _set_illum)

    # Deprecate the old shadowFactor name
    def _warn_get_shadow(self):
        deprecated.deprecationWarn(
            "EclipseMsgPayload.shadowFactor",
            "2026/12/31",
            "Use EclipseMsgPayload.illuminationFactor instead (0=fully eclipsed, 1=fully sunlit)."
        )
        return _m.{type}Payload_shadowFactor_get(self)

    def _warn_set_shadow(self, v):
        deprecated.deprecationWarn(
            "EclipseMsgPayload.shadowFactor",
            "2026/12/31",
            "Use EclipseMsgPayload.illuminationFactor instead (0=fully eclipsed, 1=fully sunlit)."
        )
        _m.{type}Payload_shadowFactor_set(self, v)

    {type}Payload.shadowFactor = property(_warn_get_shadow, _warn_set_shadow)

    # ----- Recorder aliasing so logs can use illuminationFactor -----
    try:
        _orig_rec_getattr = EclipseMsgRecorder.__getattr__

        def _rec_getattr_with_alias(self, name):
            if name == "illuminationFactor":
                # Delegate to the original implementation but ask for shadowFactor
                return _orig_rec_getattr(self, "shadowFactor")
            return _orig_rec_getattr(self, name)

        EclipseMsgRecorder.__getattr__ = _rec_getattr_with_alias
    except Exception:
        pass
%}}

%pythoncode %{{
# Freeze the payload data struct so that assigning a field name that does not
# already exist raises instead of silently succeeding (issue #305). Only the
# {type}Payload data class is protected: the Msg/Reader/Recorder/Writer and the
# std::vector wrapper classes are intentionally left untouched, because their
# custom __getattr__ has side effects that protectSetAttr's hasattr() probe would
# trigger on partially constructed objects (e.g. a Recorder mid-construction).
{type}Payload.__setattr__ = protectSetAttr
%}}
